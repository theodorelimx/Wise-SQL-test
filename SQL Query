-- =============================================================================
--
-- This file contains six queries that together build the diagnostic case from
-- overall funnel down to the specific product anomaly. Run them in order.
--
-- Schema reminder:
--   event_name   TEXT   -- 'Transfer Created' | 'Transfer Funded' | 'Transfer Transferred'
--   dt           DATE
--   user_id      INTEGER
--   region       TEXT   -- 'Europe' | 'NorthAm' | 'Other'
--   platform     TEXT   -- 'iOS' | 'Android' | 'Web'
--   experience   TEXT   -- 'New' | 'Existing'
--
-- =============================================================================


-- -----------------------------------------------------------------------------
-- 1. Overall funnel by month
-- -----------------------------------------------------------------------------

SELECT
    strftime('%Y-%m', dt)                                                  AS month,
    SUM(CASE WHEN event_name = 'Transfer Created'     THEN 1 ELSE 0 END)   AS created,
    SUM(CASE WHEN event_name = 'Transfer Funded'      THEN 1 ELSE 0 END)   AS funded,
    SUM(CASE WHEN event_name = 'Transfer Transferred' THEN 1 ELSE 0 END)   AS transferred,
    ROUND(
        1.0 * SUM(CASE WHEN event_name = 'Transfer Funded'  THEN 1 ELSE 0 END)
            / NULLIF(SUM(CASE WHEN event_name = 'Transfer Created' THEN 1 ELSE 0 END), 0),
        4
    )                                                                      AS c2f,
    ROUND(
        1.0 * SUM(CASE WHEN event_name = 'Transfer Transferred' THEN 1 ELSE 0 END)
            / NULLIF(SUM(CASE WHEN event_name = 'Transfer Funded' THEN 1 ELSE 0 END), 0),
        4
    )                                                                      AS f2t
FROM "raw data"
WHERE dt < '2024-03-01'                                                    -- exclude tail-end partial day
GROUP BY month
ORDER BY month;


-- -----------------------------------------------------------------------------
-- 2. Daily Created→Funded conversion
-- -----------------------------------------------------------------------------

SELECT
    dt,
    SUM(CASE WHEN event_name = 'Transfer Created' THEN 1 ELSE 0 END)       AS created,
    SUM(CASE WHEN event_name = 'Transfer Funded'  THEN 1 ELSE 0 END)       AS funded,
    ROUND(
        1.0 * SUM(CASE WHEN event_name = 'Transfer Funded'  THEN 1 ELSE 0 END)
            / NULLIF(SUM(CASE WHEN event_name = 'Transfer Created' THEN 1 ELSE 0 END), 0),
        4
    )                                                                      AS c2f
FROM "raw data"
WHERE dt < '2024-03-01'
GROUP BY dt
ORDER BY dt;


-- -----------------------------------------------------------------------------
-- 3. Decomposition: Created→Funded by experience and month
-- -----------------------------------------------------------------------------

SELECT
    strftime('%Y-%m', dt)                                                  AS month,
    experience,
    SUM(CASE WHEN event_name = 'Transfer Created' THEN 1 ELSE 0 END)       AS created,
    SUM(CASE WHEN event_name = 'Transfer Funded'  THEN 1 ELSE 0 END)       AS funded,
    ROUND(
        1.0 * SUM(CASE WHEN event_name = 'Transfer Funded'  THEN 1 ELSE 0 END)
            / NULLIF(SUM(CASE WHEN event_name = 'Transfer Created' THEN 1 ELSE 0 END), 0),
        4
    )                                                                      AS c2f
FROM "raw data"
WHERE dt < '2024-03-01'
GROUP BY month, experience
ORDER BY experience, month;


-- -----------------------------------------------------------------------------
-- 4. The smoking gun: share of New users in the created cohort
-- -----------------------------------------------------------------------------

SELECT
    strftime('%Y-%m', dt)                                                  AS month,
    COUNT(*)                                                               AS created_total,
    SUM(CASE WHEN experience = 'New' THEN 1 ELSE 0 END)                    AS created_new,
    ROUND(
        1.0 * SUM(CASE WHEN experience = 'New' THEN 1 ELSE 0 END) / COUNT(*),
        4
    )                                                                      AS new_share
FROM "raw data"
WHERE event_name = 'Transfer Created'
  AND dt < '2024-03-01'
GROUP BY month
ORDER BY month;


-- -----------------------------------------------------------------------------
-- 5. Anomaly hunt: full funnel by platform × experience
-- -----------------------------------------------------------------------------

SELECT
    experience,
    platform,
    SUM(CASE WHEN event_name = 'Transfer Created'     THEN 1 ELSE 0 END)   AS created,
    SUM(CASE WHEN event_name = 'Transfer Funded'      THEN 1 ELSE 0 END)   AS funded,
    SUM(CASE WHEN event_name = 'Transfer Transferred' THEN 1 ELSE 0 END)   AS transferred,
    ROUND(
        1.0 * SUM(CASE WHEN event_name = 'Transfer Funded'  THEN 1 ELSE 0 END)
            / NULLIF(SUM(CASE WHEN event_name = 'Transfer Created' THEN 1 ELSE 0 END), 0),
        4
    )                                                                      AS c2f,
    ROUND(
        1.0 * SUM(CASE WHEN event_name = 'Transfer Transferred' THEN 1 ELSE 0 END)
            / NULLIF(SUM(CASE WHEN event_name = 'Transfer Funded' THEN 1 ELSE 0 END), 0),
        4
    )                                                                      AS f2t
FROM "raw data"
WHERE dt < '2024-03-01'
GROUP BY experience, platform
ORDER BY experience, platform;


-- -----------------------------------------------------------------------------
-- 6. Confirm the Android anomaly is structural, not episodic
-- -----------------------------------------------------------------------------

SELECT
    strftime('%Y-%m', dt)                                                  AS month,
    platform,
    SUM(CASE WHEN event_name = 'Transfer Created' THEN 1 ELSE 0 END)       AS created,
    SUM(CASE WHEN event_name = 'Transfer Funded'  THEN 1 ELSE 0 END)       AS funded,
    ROUND(
        1.0 * SUM(CASE WHEN event_name = 'Transfer Funded'  THEN 1 ELSE 0 END)
            / NULLIF(SUM(CASE WHEN event_name = 'Transfer Created' THEN 1 ELSE 0 END), 0),
        4
    )                                                                      AS c2f
FROM "raw data"
WHERE experience = 'New'
  AND dt < '2024-03-01'
GROUP BY month, platform
ORDER BY platform, month;


